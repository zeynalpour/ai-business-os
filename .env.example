# ── LLM Provider ──────────────────────────────────────
# Active provider: avalai | metis
LLM_PROVIDER=metis

# AvalAI (https://avalai.ir)
AVALAI_API_KEY=your_avalai_api_key_here
LLM_USE_FLEX_TIER=true

# Metis (https://metisai.ir)
METIS_API_KEY=your_metis_api_key_here

# Model name (used by whichever provider is active)
# Metis Gemini: gemini-2.5-flash-lite, gemini-2.5-pro
# Metis OpenAI: gpt-4o-mini, gpt-4o
# Metis Grok:   grok-beta
LLM_MODEL=gemini-2.5-flash-lite

# ── Telegram ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── App ───────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
DEFAULT_TENANT_ID=default

# ── Proxy ─────────────────────────────────────────────
# Required in restricted networks (e.g. Iran)
# Format: socks5://127.0.0.1:PORT or http://127.0.0.1:PORT
# Leave empty if not needed
PROXY_URL=